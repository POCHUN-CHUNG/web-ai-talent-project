# Postgres
POSTGRES_USER=ai_talent_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_talent_db
POSTGRES_PORT=5433

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me
PGADMIN_PORT=5051

# Redis
REDIS_PASSWORD=change_me
REDIS_PORT=6380

# n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_PORT=5679
# n8n 呼叫後端「僅限 n8n」API 用的固定金鑰，產生方式見 README〈n8n 呼叫後端 API 的金鑰〉
N8N_API_KEY=change_me_long_random_string

# Frontend / Backend
FRONTEND_PORT=5174
BACKEND_PORT=8001

# 上線使用 HTTPS 時改為 true
COOKIE_SECURE=false

# 日行情資料保留期（後端每日抓取用）：保留年數（1～10，也是首次抓取的年數）與額外緩衝天數
ANALYSIS_MAX_LOOKBACK_YEARS=10
PRICE_RETENTION_BUFFER_DAYS=31
